# Formulaire public : endpoint serveur de contact, hors du scope du portail client
VITE_FORMA_CONTACT_ENDPOINT=
# Portail : UNIQUEMENT la clé publiable/anon de votre projet Forma, jamais service_role
VITE_FORMA_SUPABASE_URL=
VITE_FORMA_SUPABASE_ANON_KEY=

# Contact P0 : activer VITE_FORMA_CONTACT_ENDPOINT=/api/contact après configuration.
# Téléphone professionnel confirmé (public). Vide = aucun numéro affiché.
VITE_FORMA_PHONE=
# Exclusivement côté serveur, dans .env.local ou les paramètres de l'hébergeur.
CONTACT_DATABASE_URL=
CONTACT_RATE_SECRET=
FORMA_FOUNDER_USER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CONTACT_SMTP_URL=
CONTACT_MAIL_FROM=
